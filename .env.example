# Copier en backend/.env pour le développement local (jamais commité).
# En production, saisir ces valeurs dans les variables d'environnement Hostinger.

# Port d'écoute — injecté par Hostinger en prod ; 3000 en local.
PORT=3000

# Base MySQL. En local : votre MySQL de dev. En prod : l'hôte affiché dans hPanel
# (localhost ou srvXXXX.hstgr.io). Ne JAMAIS mettre le mot de passe réel ici.
DB_HOST=localhost
DB_PORT=3306
DB_USER=degiro_dev
DB_PASSWORD=change_me
DB_NAME=degiro_dev

# Jeton de service historique (accès propriétaire, mono-utilisateur / scripts).
# Les utilisateurs se connectent désormais par lien magique ; ce jeton agit comme
# l'utilisateur #1. Générer avec : openssl rand -hex 32
API_TOKEN=

# ── Comptes & authentification par lien magique ──────────────────────
# Email du propriétaire : devient l'utilisateur #1 au 1er démarrage et hérite des
# données existantes (account_id = 1).
OWNER_EMAIL=

# Email de l'administrateur (page Administration : gestion des inscrits).
# À défaut, l'admin est OWNER_EMAIL.
ADMIN_EMAIL=

# Base publique des liens magiques (sans slash final). En prod : https://degiro.estim.pro
# En local, laisser vide → dérivée de la requête (http://localhost:3000).
APP_URL=

# Durées de vie (jours pour la session, minutes pour le lien). Valeurs par défaut : 30 / 15.
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15

# ── Envoi d'email (SMTP) ─────────────────────────────────────────────
# Si SMTP_HOST/USER/PASS sont renseignés → liens magiques réellement envoyés.
# Sinon → mode dev : le lien est journalisé et renvoyé par l'API (dev uniquement).
# Hostinger : boîte du domaine (ex. noreply@estim.pro), hôte smtp.hostinger.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DEGIRO Analyzer <noreply@estim.pro>

# Clé API OpenFIGI gratuite pour l'enrichissement ISIN (optionnel).
OPENFIGI_API_KEY=

# Niveau de log pino (trace|debug|info|warn|error).
LOG_LEVEL=info
